*.jsonl

# ...but the parser fixtures are JSONL on purpose: that is the format under test.
# Without this the fixtures are silently un-committed and every fixture-backed
# test fails on a clean checkout with "no such file or directory".
!internal/source/testdata/**/*.jsonl
__pycache__/
.DS_Store

# Agent tooling state: node_modules and this tool's own session transcripts.
node_modules/
.opencode/

# The compiled dashboard binary. Build it with `go build -o dashd ./cmd/dashd`.
/dashd
*.test
dist/

# Test and profiling output from `go test -race -coverprofile` and friends.
*.out
*.prof
coverage.txt

# The dashboard's own database, which holds this machine's session history and
# cost figures. It is rebuilt by a scan, so there is nothing to keep in git.
*.db
*.db-wal
*.db-shm
